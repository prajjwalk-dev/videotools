# Database (local SQLite for now; see README for the Supabase switch)
DATABASE_URL="file:./dev.db"

# Groq API key — free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500

# Long files are split into chunks of this many seconds before transcription
CHUNK_SECONDS=600

# Groq chat model used to convert Hindi <-> Hinglish scripts
GROQ_TEXT_MODEL=openai/gpt-oss-120b
