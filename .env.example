# Groq API key — free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Local storage (ignored on Vercel, where media and data live in Vercel Blob)
UPLOAD_DIR=./uploads
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=500

# Long files are split into chunks of this many seconds before transcription
CHUNK_SECONDS=600

# Groq chat model used for the spelling pass and Hindi <-> Hinglish conversion
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# AI spelling pass after transcription (on by default; SPELLING_PASS=off to disable)
SPELLING_PASS=on

# Words that come up often in your recordings — given to Whisper and the spelling pass so they are spelt right
VOCABULARY=numerology, astrology, vastu, destiny number, mobile number, date of birth, birth number, business, trading, software, report, workshop, frequency, portfolio
