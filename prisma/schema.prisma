// To move to Supabase later: change provider to "postgresql", swap the adapter
// in src/lib/db.ts, point DATABASE_URL at Supabase and run `npm run db:migrate`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model MediaFile {
  id          String   @id @default(uuid())
  fileName    String
  fileType    String // "audio" | "video"
  fileFormat  String // extension, e.g. "mp4"
  fileSize    Int // bytes
  storagePath String // file name on disk inside UPLOAD_DIR
  duration    Float? // seconds, filled in during processing
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  transcription Transcription?

  @@index([uploadedAt])
}

// One job per uploaded file. The text itself lives in TranscriptVariant rows —
// one per output language/script (e.g. Hindi in Devanagari and Hinglish in Roman).
model Transcription {
  id          String    @id @default(uuid())
  mediaFileId String    @unique
  mediaFile   MediaFile @relation(fields: [mediaFileId], references: [id], onDelete: Cascade)

  spokenLanguage   String // what the user chose: "auto" | "en" | "hi" | "hi-en"
  detectedLanguage String? // Whisper's detected language code when spokenLanguage is "auto"

  status       String  @default("pending") // pending | processing | completed | failed
  progress     Int     @default(0) // 0-100
  stage        String? // human-readable current step
  errorMessage String?

  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  processingDuration    Float? // seconds

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants TranscriptVariant[]

  @@index([status])
  @@index([createdAt])
}

model TranscriptVariant {
  id              String        @id @default(uuid())
  transcriptionId String
  transcription   Transcription @relation(fields: [transcriptionId], references: [id], onDelete: Cascade)

  script    String // output language/script: "en" | "hi" (Devanagari) | "hi-en" (Roman Hinglish) | other ISO code
  source    String // "whisper" (primary, from audio) | "converted" (from the primary via LLM, segment-aligned)
  isPrimary Boolean @default(false)

  status       String  @default("pending") // pending | processing | completed | failed
  progress     Int     @default(0)
  errorMessage String?

  fullText  String?
  wordCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  segments Segment[]
  captions Caption[]

  @@unique([transcriptionId, script])
}

model Segment {
  id        String            @id @default(uuid())
  variantId String
  variant   TranscriptVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  index      Int
  startTime  Float // seconds
  endTime    Float // seconds
  text       String
  confidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId, index])
}

model Caption {
  id        String            @id @default(uuid())
  variantId String
  variant   TranscriptVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  format   String // srt | vtt | txt | json
  content  String
  fileName String
  fileSize Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, format])
}
